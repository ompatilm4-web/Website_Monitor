{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "DATA_DIR": "/tmp/data",
    "LOG_DIR": "/tmp/logs",
    "REPORTS_DIR": "/tmp/reports",
    "FLASK_DEBUG": "false"
  }
}
